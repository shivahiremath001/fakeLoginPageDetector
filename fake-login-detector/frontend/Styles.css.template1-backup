
:root {
  color-scheme: dark;
  --bg: #060b12;
  --card: rgba(15, 26, 39, 0.76);
  --card-solid: #0f1a27;
  --text: #e6f4ee;
  --muted: #8ba49b;
  --accent: #39ff88;
  --accent-dark: #12c96b;
  --border: rgba(95, 255, 166, 0.16);
  --danger: #ff5575;
  --warning: #ffb454;
  --radius: 18px;
  --shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  margin: 0;
  overflow-x: hidden;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background:
    radial-gradient(ellipse at 12% 0%, rgba(26, 183, 105, 0.13), transparent 34rem),
    radial-gradient(ellipse at 95% 30%, rgba(29, 117, 90, 0.10), transparent 30rem),
    linear-gradient(145deg, #060b12 0%, #09131c 50%, #060b12 100%);
  line-height: 1.6;
}

body::before {
  position: fixed;
  inset: 0;
  z-index: -1;
  content: "";
  pointer-events: none;
  opacity: 0.16;
  background-image: radial-gradient(rgba(117, 255, 173, 0.32) 0.7px, transparent 0.7px);
  background-size: 24px 24px;
}

::selection {
  color: #031109;
  background: var(--accent);
}

.header {
  position: relative;
  padding: 64px 20px 30px;
  text-align: center;
}

.header::before {
  display: block;
  width: 54px;
  height: 54px;
  margin: 0 auto 18px;
  border: 1px solid rgba(57, 255, 136, 0.4);
  border-radius: 17px;
  background: linear-gradient(145deg, rgba(57, 255, 136, 0.17), rgba(57, 255, 136, 0.025));
  box-shadow: 0 0 38px rgba(57, 255, 136, 0.12), inset 0 0 18px rgba(57, 255, 136, 0.06);
  content: "⌁";
  color: var(--accent);
  font-size: 36px;
  font-weight: 800;
  line-height: 50px;
}

.header h1 {
  margin: 0;
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  letter-spacing: -0.055em;
  line-height: 1.15;
  background: linear-gradient(100deg, #f3fff8 15%, #9bffc2 58%, #39ff88);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.header p {
  max-width: 620px;
  margin: 15px auto 0;
  color: var(--muted);
  font-size: 15px;
}

.container {
  width: min(100% - 32px, 1000px);
  margin: 0 auto;
  padding: 12px 0 64px;
}

.card {
  min-width: 0;
  padding: clamp(18px, 3vw, 28px);
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: linear-gradient(145deg, rgba(19, 34, 47, 0.88), rgba(10, 19, 29, 0.78));
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.card h2,
.card h3 {
  margin-top: 0;
  color: #eafff2;
  letter-spacing: -0.025em;
}

.card h3 {
  margin-bottom: 18px;
  font-size: 18px;
  font-weight: 750;
}

#scan-section {
  position: relative;
  border-color: rgba(57, 255, 136, 0.26);
}

#scan-section::before {
  position: absolute;
  top: 0;
  left: 28px;
  width: 90px;
  height: 2px;
  background: var(--accent);
  box-shadow: 0 0 18px rgba(57, 255, 136, 0.65);
  content: "";
}

label {
  display: block;
  margin-bottom: 10px;
  color: #d7e9df;
  font-size: 14px;
  font-weight: 650;
}

input {
  display: block;
  width: 100%;
  min-width: 0;
  padding: 15px 16px;
  border: 1px solid rgba(137, 173, 154, 0.25);
  border-radius: 12px;
  outline: none;
  background: rgba(3, 10, 16, 0.72);
  color: var(--text);
  font: inherit;
  font-size: 15px;
  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

input::placeholder {
  color: #5e776c;
}

input:focus {
  border-color: rgba(57, 255, 136, 0.72);
  background: rgba(3, 13, 17, 0.9);
  box-shadow: 0 0 0 4px rgba(57, 255, 136, 0.08);
}

button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 48px;
  width: 100%;
  margin-top: 14px;
  padding: 13px 20px;
  border: 1px solid rgba(120, 255, 177, 0.5);
  border-radius: 12px;
  background: linear-gradient(110deg, #39ff88, #19d975);
  box-shadow: 0 8px 28px rgba(27, 226, 112, 0.14);
  color: #03140a;
  font: inherit;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
}

button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 34px rgba(27, 226, 112, 0.23);
  filter: brightness(1.04);
}

button:active {
  transform: translateY(0);
}

button:focus-visible {
  outline: 2px solid #eafff2;
  outline-offset: 3px;
}

button:disabled {
  transform: none;
  opacity: 0.58;
  cursor: wait;
}

button.secondary {
  border-color: rgba(139, 164, 155, 0.22);
  background: rgba(26, 42, 52, 0.9);
  box-shadow: none;
  color: var(--text);
}

.hidden {
  display: none !important;
}

#results {
  margin-top: 22px;
  animation: reveal 420ms ease both;
}

#results > * {
  min-width: 0;
}

#results .card {
  margin-bottom: 18px;
}

@keyframes reveal {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.score {
  color: var(--danger);
  font-size: clamp(2rem, 6vw, 3.2rem);
  font-weight: 850;
  letter-spacing: -0.06em;
  line-height: 1.15;
}

.gauge {
  margin: 12px 0;
  text-align: center;
}

.gauge p {
  margin: 5px 0 0;
  color: var(--muted);
}

.gauge svg,
.gauge canvas {
  max-width: 100%;
}

#compare-box,
#reasons-box,
#breakdown-box,
#domain-box,
#attack-box,
#report-box {
  margin-top: 18px;
}

.compare-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
  gap: 16px;
}

.shot {
  min-width: 0;
  margin: 0;
  padding: 10px;
  border: 1px solid rgba(139, 164, 155, 0.15);
  border-radius: 14px;
  background: rgba(3, 10, 16, 0.42);
}

.shot img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  border: 1px solid rgba(139, 164, 155, 0.18);
  border-radius: 9px;
  background: #071019;
}

.shot figcaption {
  padding: 10px 3px 2px;
  color: #b5cfc1;
  font-size: 13px;
  font-weight: 650;
  text-align: center;
}

.reasons {
  margin: 0;
  padding: 0;
  list-style: none;
}

.reason {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 0;
  border-top: 1px solid rgba(139, 164, 155, 0.13);
}

.reason:first-child {
  border-top: none;
}

.reason p {
  margin: 5px 0 0;
  color: #9eb4a9;
  font-size: 14px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.badge {
  flex-shrink: 0;
  height: fit-content;
  padding: 4px 9px;
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.055em;
  text-transform: uppercase;
}

.badge.critical {
  border-color: rgba(255, 85, 117, 0.3);
  background: rgba(255, 85, 117, 0.13);
  color: #ff8298;
}

.badge.high {
  border-color: rgba(255, 180, 84, 0.28);
  background: rgba(255, 180, 84, 0.12);
  color: #ffc57f;
}

.badge.medium {
  border-color: rgba(250, 204, 21, 0.25);
  background: rgba(250, 204, 21, 0.10);
  color: #f5db69;
}

.badge.low,
.badge.info {
  border-color: rgba(57, 255, 136, 0.2);
  background: rgba(57, 255, 136, 0.08);
  color: #8dffb7;
}

.bar-row {
  margin-bottom: 20px;
}

.bar-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  font-size: 13px;
  font-weight: 700;
}

.bar-label span:last-child {
  flex-shrink: 0;
  color: #9eb4a9;
  font-weight: 550;
  font-variant-numeric: tabular-nums;
}

.bar-track {
  height: 8px;
  overflow: hidden;
  border: 1px solid rgba(139, 164, 155, 0.08);
  border-radius: 20px;
  background: rgba(139, 164, 155, 0.12);
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #17c96a, #75ffad);
  box-shadow: 0 0 14px rgba(57, 255, 136, 0.28);
  transition: width 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.domain-label {
  margin: 14px 0 6px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.domain {
  margin: 0;
  overflow-wrap: anywhere;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: clamp(13px, 2vw, 17px);
}

.domain.real {
  color: var(--accent);
}

.domain.fake {
  color: #ff8298;
}

.bad-char {
  padding: 1px 3px;
  border-radius: 3px;
  background: rgba(255, 85, 117, 0.2);
  color: #ff9bab;
  text-decoration: underline;
  text-decoration-color: rgba(255, 85, 117, 0.75);
}

.domain-note,
.path-note {
  margin: 12px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.path {
  position: relative;
  padding-top: 28px;
}

.path-line {
  position: absolute;
  top: 10px;
  right: 16.6%;
  left: 16.6%;
  height: 3px;
  border-radius: 4px;
  background: rgba(139, 164, 155, 0.22);
}

.path-dot {
  position: absolute;
  top: -5px;
  left: 0;
  width: 13px;
  height: 13px;
  border: 2px solid #08130d;
  border-radius: 50%;
  background: var(--danger);
  box-shadow: 0 0 14px rgba(255, 85, 117, 0.6);
  animation: travel 2.5s linear infinite;
}

@keyframes travel {
  from { left: 0; }
  to { left: calc(100% - 13px); }
}

.path-nodes {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  text-align: center;
}

.node {
  min-width: 0;
  padding: 13px 8px;
  border: 1px solid rgba(139, 164, 155, 0.17);
  border-radius: 12px;
  background: rgba(3, 10, 16, 0.44);
}

.node.bad {
  border-color: rgba(255, 180, 84, 0.45);
}

.node.worst {
  border-color: rgba(255, 85, 117, 0.5);
}

.node-icon {
  font-size: 25px;
}

.node small {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
  overflow-wrap: anywhere;
}

#report-box {
  padding-bottom: 32px;
}

a {
  color: #85ffb1;
  text-decoration-color: rgba(133, 255, 177, 0.35);
  text-underline-offset: 3px;
  overflow-wrap: anywhere;
}

a:hover {
  color: #c0ffd7;
  text-decoration-color: currentColor;
}

:focus-visible {
  outline-color: var(--accent);
}

@media (min-width: 700px) {
  .header {
    padding-top: 76px;
  }

  #scan-section button {
    width: auto;
    min-width: 180px;
  }
}

@media (max-width: 520px) {
  .header {
    padding-top: 42px;
  }

  .header p {
    font-size: 14px;
  }

  .container {
    width: min(100% - 22px, 1000px);
  }

  .card {
    padding: 17px;
    border-radius: 15px;
  }

  .reason {
    gap: 9px;
  }

  .bar-label {
    align-items: flex-start;
    font-size: 12px;
  }

  .path-nodes {
    gap: 5px;
  }

  .node {
    padding: 10px 4px;
  }

  .node-icon {
    font-size: 21px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media print {
  :root {
    color-scheme: light;
  }

  body {
    color: #111;
    background: white;
  }

  body::before,
  .header p,
  #scan-section,
  #report-box {
    display: none !important;
  }

  .header h1 {
    color: #111;
    background: none;
  }

  .card {
    break-inside: avoid;
    border: 1px solid #ccc;
    background: white;
    box-shadow: none;
    color: #111;
  }

  .card h3,
  .reason p,
  .domain-note,
  .path-note {
    color: #333;
  }
}
